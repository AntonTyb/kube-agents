bin/

# Environment Files
.env
.env.*
!*.env.example
k8s-operator/cover.out

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/

# Terraform working directories (providers are re-fetched by terraform init;
# lock files are only meaningful in root configurations, not shipped modules)
.terraform/
.terraform.lock.hcl

# Terraform state and variable files hold credentials and infrastructure
# details — never commit them. Committed examples keep the .example suffix.
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
terraform.tfvars.json
